# nginx config for the React frontend.
# This is a template: at container start the nginx image replaces
# ${BACKEND_URL} with the environment variable (envsubst).

# JSON access logs, so Loki can parse every field.
log_format json_combined escape=json
  '{"ts":"$time_iso8601","remote_addr":"$remote_addr","method":"$request_method",'
  '"path":"$request_uri","status":$status,"bytes":$body_bytes_sent,'
  '"duration_s":$request_time,"user_agent":"$http_user_agent"}';

server {
    listen 8080;            # unprivileged image: no root needed for ports > 1024
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    access_log /dev/stdout json_combined;
    server_tokens off;      # do not advertise the nginx version
    client_max_body_size 2m; # same limit as Flask (JSON import)

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Probe endpoint for Docker / Kubernetes.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API calls go to Flask. (In Kubernetes the Ingress usually sends /api
    # straight to the backend Service; this keeps docker-compose working.)
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Vite puts a content hash in asset file names (index-DPgFTEKX.js),
    # so they can be cached "forever"; a new build gets new names.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    # Single-page app: unknown paths (/map, /locations/3/edit) return
    # index.html and React Router shows the right page.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
}
